# Shared dark rose palette; matching config/kitty/theme.conf and docs/style.md.
# Thin muted frames, readable labels, and the shared rose / purple accents.
# theme_background = False in btop.conf preserves Kitty's translucent background.
# btop 1.4.7 shares CPU colors with GPU utilization, used colors with VRAM,
# and available / used colors with disk read / write graphs.
theme[main_bg] = "#19151c"
theme[main_fg] = "#ede5ec"
theme[title] = "#ede5ec"
theme[hi_fg] = "#f2a5c7"
theme[selected_bg] = "#3b2c3b"
theme[selected_fg] = "#ede5ec"
theme[inactive_fg] = "#b3a2b1"
theme[graph_text] = "#b3a2b1"
theme[meter_bg] = "#574254"
theme[proc_misc] = "#c9adeb"
theme[cpu_box] = "#574254"
theme[mem_box] = "#574254"
theme[net_box] = "#574254"
theme[proc_box] = "#574254"
theme[div_line] = "#574254"
theme[temp_start] = "#9bcbd3"
theme[temp_mid] = "#e7c38c"
theme[temp_end] = "#f08091"
theme[cpu_start] = "#f2a5c7"
theme[cpu_mid] = "#e7c38c"
theme[cpu_end] = "#f08091"
theme[free_start] = "#a6c7a0"
theme[free_mid] = "#a6c7a0"
theme[free_end] = "#a6c7a0"
theme[cached_start] = "#9bcbd3"
theme[cached_mid] = "#9bcbd3"
theme[cached_end] = "#9bcbd3"
theme[available_start] = "#e7c38c"
theme[available_mid] = "#e7c38c"
theme[available_end] = "#e7c38c"
theme[used_start] = "#c9adeb"
theme[used_mid] = "#f2a5c7"
theme[used_end] = "#f08091"
theme[download_start] = "#a7b9ed"
theme[download_mid] = "#a7b9ed"
theme[download_end] = "#a7b9ed"
theme[upload_start] = "#9bcbd3"
theme[upload_mid] = "#9bcbd3"
theme[upload_end] = "#9bcbd3"
theme[process_start] = "#f2a5c7"
theme[process_mid] = "#e7c38c"
theme[process_end] = "#f08091"
theme[proc_pause_bg] = "#e7c38c"
theme[proc_follow_bg] = "#c9adeb"
theme[proc_banner_bg] = "#f2a5c7"
theme[proc_banner_fg] = "#19151c"
theme[followed_bg] = "#3b2c3b"
theme[followed_fg] = "#ede5ec"
