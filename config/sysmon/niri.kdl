// Opt-in monitor profile. Include from dotfiles-local/niri.kdl after deployment.
binds {
    Mod+M hotkey-overlay-title="Hardware monitor · CPU / GPU / RAM" {
        spawn-sh "\"$HOME/.local/bin/sysmon\" --window";
    }
    Mod+Shift+M hotkey-overlay-title="GPU monitor · Processes / VRAM" {
        spawn-sh "\"$HOME/.local/bin/sysmon\" --window gpu";
    }
}

// Half the usable width and half the height: one quarter of the desktop.
// Match only monitor titles; ordinary Kitty windows keep their layout.
window-rule {
    match app-id="^kitty$" title="^(Hardware|GPU) Monitor$"
    open-floating true
    default-column-width { proportion 0.5; }
    default-window-height { proportion 0.5; }
    default-floating-position x=16 y=16 relative-to="bottom-right"
    background-effect { blur false; xray false; }
}
