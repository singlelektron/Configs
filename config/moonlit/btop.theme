# Generated by scripts/moonlit-theme.py; edit palette.json.
# Thin muted frames, readable labels, and the shared rose / purple accents.
# theme_background = False in btop.conf preserves Kitty's translucent background.
# btop 1.4.7 shares CPU colors with GPU utilization, used colors with VRAM,
# and available / used colors with disk read / write graphs.
theme[main_bg] = "#18131f"
theme[main_fg] = "#f1e8f1"
