# Started only by desktopctl session-start; deliberately not enable-able.
[Unit]
Description=Rose Observatory authentication agent
PartOf=niri.service graphical-session.target
After=niri.service graphical-session.target
Requisite=niri.service graphical-session.target

[Service]
Type=simple
UnsetEnvironment=GDK_BACKEND
ExecStart=/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
Restart=on-failure
RestartSec=2
Slice=session.slice
